{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/map",
      "destination": "/map"
    },
    {
      "source": "/user/login",
      "destination": "/user_login"
    },
    {
      "source": "/user/signup",
      "destination": "/user_signup"
    },
    {
      "source": "/user/dashboard",
      "destination": "/user_dashboard"
    },
    {
      "source": "/admin/login",
      "destination": "/admin_login"
    },
    {
      "source": "/admin",
      "destination": "/admin"
    },
    {
      "source": "/user/logout",
      "destination": "https://roadsight-backend.onrender.com/user/logout"
    },
    {
      "source": "/admin/logout",
      "destination": "https://roadsight-backend.onrender.com/admin/logout"
    },
    {
      "source": "/analyze",
      "destination": "https://roadsight-backend.onrender.com/analyze"
    },
    {
      "source": "/submit-report",
      "destination": "https://roadsight-backend.onrender.com/submit-report"
    },
    {
      "source": "/generate-description",
      "destination": "https://roadsight-backend.onrender.com/generate-description"
    },
    {
      "source": "/generate-shareable-image",
      "destination": "https://roadsight-backend.onrender.com/generate-shareable-image"
    },
    {
      "source": "/api/:path*",
      "destination": "https://roadsight-backend.onrender.com/api/:path*"
    },
    {
      "source": "/static/uploads/:path*",
      "destination": "https://roadsight-backend.onrender.com/static/uploads/:path*"
    },
    {
      "source": "/static/generated/:path*",
      "destination": "https://roadsight-backend.onrender.com/static/generated/:path*"
    }
  ]
}
